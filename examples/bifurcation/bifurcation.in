# Synthetic test case: trachea + two main bronchi (symmetric bifurcation).
# Units: CGS (cm, g, s). Lines starting with '#' are comments.
# Segments are oriented from the distal node (inlet) to the proximal node (outlet),
# as in the airway trees used in the paper.

# NODE  name  x  y  z
NODE 0 0.0 0.0 0.0
NODE 1 0.0 0.0 -10.0
NODE 2 -2.0 0.0 -13.5
NODE 3 2.0 0.0 -13.5

# JOINT  name  node  inletList  outletList
JOINT J0 1 IN0 OUT0
JOINTINLET IN0 2 1 2
JOINTOUTLET OUT0 1 0

# SEGMENT name id length nElements inNode outNode inArea outArea initFlow material
#         lossType branchAngle upstreamSeg branchSeg boundaryType dataTable
SEGMENT seg0 0 10.0 50 1 0 2.5446900494077327 2.5446900494077327 0.0 MAT1 NONE 0.0 0 0 PRESSURE P_EXT
SEGMENT seg1 1 4.03 20 2 1 1.1309733552923256 1.1309733552923256 0.0 MAT1 NONE 0.0 0 0 FLOW INFLOW1
SEGMENT seg2 2 4.03 20 3 1 1.1309733552923256 1.1309733552923256 0.0 MAT1 NONE 0.0 0 0 FLOW INFLOW2

# Pressure imposed at the trachea (cmH2O-relative, here 0)
DATATABLE P_EXT LIST
0.0 0.0
ENDDATATABLE

# Flow imposed at the distal end of seg1 (mL/s), one breathing cycle
DATATABLE INFLOW1 LIST
0.000000 0.00000000
0.125000 38.30589515
0.250000 75.13971624
0.375000 109.08596016
