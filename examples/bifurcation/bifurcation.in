# SOLVEROPTIONS dt saveFreq maxSteps quadPoints cycleTime tolerance useIV useStab
SOLVEROPTIONS 0.001 20 8000 2 4.0 1.0e-5 1 1

# MATERIAL name AIRWAYS density viscosity pRef exponent k1 k2 k3
MATERIAL MAT1 AIRWAYS 0.0012 0.000185 0 2.0 211747.52 0.0 35688.15

# OUTPUT format vtkType
OUTPUT TEXT
